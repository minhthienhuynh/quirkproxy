# quirkproxy runtime environment overrides.
#
# These are READ BY THE PROCESS ENVIRONMENT, not parsed from this file. Load it
# into the environment yourself, e.g.:
#   docker run --env-file .env ...
#   set -a; source .env; set +a; ./quirkproxy -config config.sample.json
# or paste the values into your platform's environment panel (Dokploy, K8s...).
# Values here take precedence over `listen` in the config file; unset parts
# fall back to it.

# Bind host (overrides the host part of `listen`). Example: 0.0.0.0
QUIRKPROXY_HOST=

# Bind port, 1-65535 (overrides the port part of `listen`). Example: 9090
QUIRKPROXY_PORT=
